# Copy this file to .env and adjust as needed. Never commit the real .env.

ALPHASCOPE_ENV=development

# "yfinance" (default) is real, delayed Yahoo Finance data for both tabs —
# no API key needed. "mock" is synthetic random-walk data (no network) for
# offline dev/testing. "massive" requires MASSIVE_API_KEY, or the app falls
# back to yfinance automatically.
MARKET_DATA_PROVIDER=yfinance
MASSIVE_API_KEY=

# SQLite by default so the app runs without any database server installed.
# Point this at a Postgres URL in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/alphascope
DATABASE_URL=sqlite:///./alphascope.db

# Optional. Leave empty to use the built-in in-memory cache/event layer.
REDIS_URL=

# Safety: paper trading only. LIVE_TRADING_ENABLED must stay false — the
# codebase has no real order-execution path, and setting this true is
# rejected at startup by app/config.py.
PAPER_TRADING_ONLY=true
LIVE_TRADING_ENABLED=false

# SCANNER_INTERVAL_SECONDS controls indicator recompute cadence for every
# provider. Kept conservative by default because low-CPU free-tier hosts
# (Render's 0.1 CPU plan) can get starved badly enough to trigger a
# host-level restart; lower it on a beefier host for fresher updates.
# MOCK_TICK_INTERVAL_SECONDS/MOCK_RANDOM_SEED only apply when
# MARKET_DATA_PROVIDER=mock.
SCANNER_INTERVAL_SECONDS=20
MOCK_TICK_INTERVAL_SECONDS=3
MOCK_RANDOM_SEED=42

INITIAL_PAPER_CASH=100000

# Global (ABD) tab — uses Yahoo Finance (yfinance), no API key needed, same
# as BIST. Edit GLOBAL_SYMBOLS (comma-separated, no suffix) to track a
# different list of US tickers. Default is ~50 large/liquid, well-known
# companies spread across sectors (tech, finance, healthcare, consumer,
# energy, telecom, industrials).
GLOBAL_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,AMZN,META,AMD,ORCL,CRM,ADBE,INTC,CSCO,NFLX,DIS,TMUS,JPM,V,MA,BAC,WFC,GS,MS,JNJ,UNH,PFE,ABBV,MRK,WMT,PG,KO,PEP,COST,HD,MCD,NKE,TSLA,BA,CAT,GE,XOM,CVX,COP,VZ,T,UBER,PYPL,SBUX,LOW,TXN,QCOM
GLOBAL_POLL_INTERVAL_SECONDS=60

# BIST 30 tab — uses Yahoo Finance (yfinance), no API key needed. Data is
# typically delayed ~15-20 minutes; not a substitute for your broker's feed.
# Edit BIST_SYMBOLS (comma-separated, no ".IS" suffix) to track a different list.
# List verified against the live BIST 30 index on 2026-09-07 — Borsa
# İstanbul reviews index membership quarterly, so re-check periodically.
BIST_ENABLED=true
BIST_SYMBOLS=AEFES,AKBNK,ASELS,ASTOR,BIMAS,DSTKF,EKGYO,ENKAI,EREGL,FROTO,GARAN,GUBRF,ISCTR,KCHOL,KRDMD,MGROS,PETKM,PGSUS,SAHOL,SASA,SISE,TAVHL,TCELL,THYAO,TOASO,TRALT,TTKOM,TUPRS,VAKBN,YKBNK
BIST_POLL_INTERVAL_SECONDS=60
BIST_INITIAL_PAPER_CASH=1000000

# Crypto tab — uses Yahoo Finance (yfinance), no separate exchange
# integration (e.g. ccxt) needed; yfinance already covers crypto via a
# "-USD" suffix. Trades 24/7, so unlike Global/BIST there's no "market
# closed" excuse for stale data. No fundamentals (no issuing company).
CRYPTO_ENABLED=true
CRYPTO_SYMBOLS=BTC,ETH,BNB,SOL,XRP,ADA,DOGE,AVAX
CRYPTO_POLL_INTERVAL_SECONDS=60
CRYPTO_INITIAL_PAPER_CASH=100000

# News + sentiment (Yahoo Finance headlines, scored locally by FinBERT — no
# API key). First run downloads the model (~500MB) from Hugging Face; after
# that it's cached and works offline. If torch/transformers aren't
# installed, headlines still show, just without sentiment scoring.
NEWS_ENABLED=true
NEWS_POLL_INTERVAL_SECONDS=900
NEWS_MAX_ITEMS_PER_SYMBOL=8

# Long-term outlook (fundamentals) and macro context — see README for a
# known limitation: fundamentals' data source is unreliable from some
# cloud-hosting IPs.
FUNDAMENTALS_POLL_INTERVAL_SECONDS=21600
MACRO_POLL_INTERVAL_SECONDS=60

# How often to refresh each symbol's daily-bar (EMA50/EMA200) trend
# direction — used by AutoTrader as a multi-timeframe confirmation gate
# (see "Otomatik simülasyon" in README). Day-scale, so a slow poll is plenty.
DAILY_TREND_POLL_INTERVAL_SECONDS=21600

# How often the automated N-day simulation checks signals and trades.
AUTOTRADER_TICK_INTERVAL_SECONDS=60

# How often to check for due signal-performance checkpoints (5/10/20 days
# after a signal change) — see "Sinyal performansı" in README. Day-scale
# data, hourly is plenty.
SIGNAL_TRACKING_INTERVAL_SECONDS=3600

LOG_LEVEL=INFO
